# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.

# W&B 키
WANDB_API_KEY=

# W&B 팀 이름
WANDB_ENTITY=

# Colab에서 사용할 원본 데이터 위치: 내 Drive에 올린 원본 zip 또는 폴더 경로. 예) /content/drive/MyDrive/<폴더>/raw.zip
DRIVE_RAW=

# 2차 마일스톤: 식의약 데이터 포털 공공 API
DATA_GO_API_KEY=

# AI Hub API 키: 576 데이터셋(경구약제 이미지) 이용 승인을 받은 뒤 발급받은 키. scripts/download_aihub.py가 읽는다.
AIHUB_APIKEY=
