# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.
# Colab: .env를 내 드라이브의 MyDrive/.secret/pill-object-detection.env로 올리면 실험용 공용 노트북이 읽습니다.
# Kaggle: .env 대신 Add-ons → Secrets에 같은 이름으로 넣습니다.

# W&B 키
WANDB_API_KEY=

# W&B 팀 이름
WANDB_ENTITY=

# Colab에서 사용할 원본 데이터 위치: 내 Drive에 올린 원본 zip 또는 폴더 경로. 예) /content/drive/MyDrive/<폴더>/raw.zip
DRIVE_RAW=

# 2차 마일스톤: 식의약 데이터 포털 공공 API
DATA-GO-API-KEY=
