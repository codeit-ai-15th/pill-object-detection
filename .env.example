# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.

# W&B 키
WANDB_API_KEY=

# W&B 팀 이름
WANDB_ENTITY=

# GoogleDrive 공유 폴더 위치
DRIVE_BASE=

# 데모 약 정보 캐시(demo/build_drug_info.py)가 쓰는 공공데이터포털 키. 의약품 제품 허가정보 API 활용신청 후 일반 인증키(Decoding)
DATA_GO_API_KEY=
# (생략 가능) 허가정보 API 주소. 서비스까지만 적으면(예: https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService08) 상세 조회 오퍼레이션을 붙인다
DATA_GO_BASE_URL=

# 데모(demo/app.py)에서 쓸 가중치 .pt 경로. 계열마다 하나. 비우면 그 모델은 데모에 안 보임. 상대 경로는 레포 최상위 기준
# 예) PILL_DEMO_YOLO=runs/models/exp2_v3_yolo26s_e10_s0_best.pt
PILL_DEMO_YOLO=
PILL_DEMO_RTDETR=
PILL_DEMO_FRCNN=

# HF Space 배포(demo/deploy_space.py)용 Hugging Face 토큰(write 권한)
HF_TOKEN=

# AI Hub API 키: 576 데이터셋(경구약제 이미지) 이용 승인을 받은 뒤 발급받은 키. scripts/download_aihub.py가 읽는다.
AIHUB_APIKEY=

# 테스트 전용(보통 비워 둠): 이미 만든 AI Hub 결과 폴더를 다시 만들지 않고 검사만 할 때 그 폴더. 예) data/processed/ai_hub
# 테스트는 .env를 읽지 않으므로 명령 앞에 붙여 씁니다: PILL_TEST_AIHUB_EXPORT=data/processed/ai_hub uv run pytest tests/test_train_dataset.py -k aihub
PILL_TEST_AIHUB_EXPORT=
